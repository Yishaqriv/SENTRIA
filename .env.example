# Copiar a .env y completar con valores reales. Nunca commitear .env.
# Las variables marcadas (obligatoria) no tienen valor de respaldo: si faltan,
# sentria_project/settings.py falla al iniciar con un mensaje explícito.

# Django
DJANGO_SECRET_KEY=            # obligatoria: generar una clave nueva por entorno, nunca reutilizar una expuesta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (si se accede mediante un túnel, host y puerto pueden
# ser efímeros y cambiar al reiniciarlo; confirmar los valores vigentes con
# quien administre la base antes de completarlos aquí)
DB_NAME=bdsentria
DB_USER=                      # obligatoria
DB_PASSWORD=                  # obligatoria
DB_HOST=                      # obligatoria
DB_PORT=                      # obligatoria

# Indexador Wazuh (OpenSearch)
WAZUH_URL=https://localhost:9200
INDEXER_USER=
INDEXER_PASS=
# SHA-256 (64 hex) del certificado DER del indexador. OBLIGATORIO: sin él (o si no coincide) SENTRIA no consulta
# Wazuh ni envía credenciales. Obtenerlo del certificado real; no copiar valores de ejemplo.
WAZUH_TLS_SHA256=
WAZUH_INDEX_NAME=wazuh-alerts-*

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash

# Proveedor de IA: gemini_developer (por defecto) | vertex_tuned (EXPERIMENTAL, desactivado por defecto)
IA_PROVIDER=gemini_developer
# Modelo ajustado en Vertex / Agent Platform: solo actúa con IA_PROVIDER=vertex_tuned e IA_VERTEX_HABILITADO=1.
# Autenticación con credenciales predeterminadas de aplicación (ADC) de Google; nunca claves en este archivo.
IA_VERTEX_HABILITADO=0
GEMINI_TUNED_ENDPOINT=        # projects/<número de proyecto>/locations/us/endpoints/<id>
# Autenticación de vertex_tuned: adc (por defecto) | token_archivo (SOLO pruebas controladas: token de acceso de
# corta duración en un archivo 600 FUERA del repositorio; sin renovación; conserva los permisos de quien lo obtuvo).
VERTEX_AUTENTICACION=adc
VERTEX_TOKEN_ARCHIVO=         # ruta absoluta, solo con VERTEX_AUTENTICACION=token_archivo

# Archivo de entorno: SENTRIA_ENV_FILE se define en el entorno del proceso (unidad
# de servicio, docker run o terminal), no en este archivo. Si se define, el archivo
# debe existir y tener permisos 600 o más restrictivos.

# Modo de aprobación del conjunto de ajuste: DOBLE (por defecto) | REVISOR_UNICO_LOTE.
# No cambiarlo sin una decisión registrada.
SENTRIA_MODO_REVISION=DOBLE

# agent.id de Wazuh que no se asocian a un activo ni se envían al modelo,
# separados por comas. Vacío: ninguno.
IA_AGENTES_BLOQUEADOS=

# Solo imagen Docker: 1 aplica las migraciones al arrancar (pruebas con base temporal).
# Contra una base real, dejar 0 y migrar a mano después de un respaldo.
SENTRIA_MIGRAR_AL_ARRANCAR=0
