# Copiar a .env y completar con valores reales. Nunca commitear .env.
# Las variables marcadas (obligatoria) no tienen valor de respaldo: si faltan,
# sentria_project/settings.py falla al iniciar con un mensaje explícito.

# Django
DJANGO_SECRET_KEY=            # obligatoria: generar una clave nueva por entorno, nunca reutilizar una expuesta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (si se accede mediante un túnel, host y puerto pueden
# ser efímeros y cambiar al reiniciarlo; confirmar los valores vigentes con
# quien administre la base antes de completarlos aquí)
DB_NAME=bdsentria
DB_USER=                      # obligatoria
DB_PASSWORD=                  # obligatoria
DB_HOST=                      # obligatoria
DB_PORT=                      # obligatoria

# Indexador Wazuh (OpenSearch)
WAZUH_URL=https://localhost:9200
INDEXER_USER=
INDEXER_PASS=
WAZUH_INDEX_NAME=wazuh-alerts-*

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash
